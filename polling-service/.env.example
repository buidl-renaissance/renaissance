# Renaissance Event Polling Service - Environment Variables

# External Event Source APIs (defaults provided)
LUMA_API_URL=https://luma-events-inky.vercel.app
RA_API_URL=https://ra-events.vercel.app
MEETUP_API_URL=https://meetup.builddetroit.xyz

# Renaissance Events API for upserting events
EVENTS_API_URL=https://events.builddetroit.xyz
EVENTS_API_KEY=your-api-key-here

# Optional: Secret for authenticating cron job requests
CRON_SECRET=your-cron-secret-here
